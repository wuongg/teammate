# Neon Postgres — dùng connection POOLER cho Vercel (nhanh hơn)
# Trong Neon Console: Connection Details → "Pooled connection"
# Host có dạng: ep-xxx-pooler.region.aws.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Port server (mặc định 3000)
PORT=3000
